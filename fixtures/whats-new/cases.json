{
  "description": "Red-first cases for the whats-new checker. Pages are served from a built site: the part's lib and reference pages plus these fixture pages; clips and posters are built at run time by buildWhatsNewMedia. Each fail page plants one defect on top of the shipped lib and runs only its rule.",
  "cases": [
    {
      "id": "wn-ref-single",
      "rule": ["WN-DIALOG-01", "WN-NAV-01", "WN-LAYOUT-01", "WN-MEDIA-01", "WN-MOTION-01", "WN-TARGET-01", "WN-ONCE-01"],
      "expect": "pass",
      "checker": "check-whats-new",
      "page": "reference/whats-new-single.html",
      "server": "range",
      "args": ["--version", "2.4.0"]
    },
    {
      "id": "wn-ref-pager",
      "rule": ["WN-DIALOG-01", "WN-NAV-01", "WN-LAYOUT-01", "WN-MEDIA-01", "WN-MOTION-01", "WN-TARGET-01", "WN-ONCE-01"],
