      "checker": "check-whats-new",
      "page": "reference/whats-new-pager.html",
      "server": "range",
      "args": ["--version", "2.4.0", "--viewport", "1280x900", "--viewport", "390x844"]
    },
    {
      "id": "wn-pager-video",
