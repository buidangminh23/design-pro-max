    { "id": "launchd-01-current", "rule": "HO-LAUNCHD-01", "expect": "pass", "checker": "probe-launchd", "label": "com.example.sync", "domain": "gui/501", "plist": "launchd/com.example.sync.plist", "print": "launchd/print-current.txt", "exit": 0 },
