    { "id": "warn-01-open-env", "rule": "HO-WARN-OPENENV", "expect": "warn", "checker": "scan-host", "sources": ["scripts/open-env.sh"] },
    { "id": "warn-02-log-builtin", "rule": "HO-WARN-LOG", "expect": "warn", "checker": "scan-host", "sources": ["scripts/log-builtin.zsh"] },
