    { "id": "launchd-05-last-exit", "rule": "HO-LAUNCHD-01", "expect": "fail", "checker": "probe-launchd", "label": "com.example.sync", "domain": "gui/501", "plist": "launchd/com.example.sync.plist", "print": "launchd/print-exit-78.txt", "exit": 0 },
    { "id": "launchd-06-other-file", "rule": "HO-LAUNCHD-01", "expect": "fail", "checker": "probe-launchd", "label": "com.example.sync", "domain": "gui/501", "plist": "launchd/com.example.sync.plist", "print": "launchd/print-other-path.txt", "exit": 0 }
