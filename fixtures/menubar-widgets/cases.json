{
  "description": "menubar-widgets fixtures. scripts/verify.mjs runs each case against a copy of the shipped part outside the repository. Sources are relative to this folder, or to the part folder when they start with assets/. scan-swift cases read Swift text and run anywhere. probe-extension cases judge recorded ps and lsof output against probe/Forecast.app; @APP@ in a recording stands for the copied app's absolute path and @DIR@ for the folder that holds it and the copies listed in copies; tz is the recording machine's UTC offset. snapshot-widgets cases build the renderer with swiftc and run only where platform matches; a case with baselineSources first writes a baseline from those sources with --update, then compares. No baseline or PNG is committed. A fail case must exit 1 with an error for its rule; a pass case must report its rule as passed with no error for it; a warn case must warn.",
  "cases": [
    { "id": "scan-shipped-assets", "rule": ["MW-APPEAR-01", "MW-CONFIG-01"], "expect": "pass", "checker": "scan-swift", "sources": ["assets/StatusItemController.swift", "assets/ConfigurableWidget.swift"] },
    { "id": "appear-01-kvo-redraw", "rule": "MW-APPEAR-01", "expect": "fail", "checker": "scan-swift", "sources": ["swift/appear-01-kvo-redraw.swift"] },
    { "id": "appear-02-publisher-image", "rule": "MW-APPEAR-01", "expect": "fail", "checker": "scan-swift", "sources": ["swift/appear-02-publisher-image.swift"] },
    { "id": "config-01-static-with-intent", "rule": "MW-CONFIG-01", "expect": "fail", "checker": "scan-swift", "sources": ["swift/config-01-static-with-intent.swift"] },
    { "id": "config-02-static-when-configurable", "rule": "MW-CONFIG-01", "expect": "fail", "checker": "scan-swift", "args": ["--configurable", "com.example.weather.current"], "sources": ["swift/config-02-static-only.swift"] },
    { "id": "config-03-static-not-requested", "rule": "MW-CONFIG-01", "expect": "pass", "checker": "scan-swift", "sources": ["swift/config-02-static-only.swift"] },
    { "id": "appear-03-redraw-before-guard", "rule": "MW-APPEAR-01", "expect": "fail", "checker": "scan-swift", "sources": ["swift/appear-03-redraw-before-guard.swift"] },
    { "id": "appear-04-compare-not-guarding", "rule": "MW-APPEAR-01", "expect": "fail", "checker": "scan-swift", "sources": ["swift/appear-04-compare-not-guarding.swift"] },
    { "id": "appear-05-map-then-sink", "rule": "MW-APPEAR-01", "expect": "fail", "checker": "scan-swift", "sources": ["swift/appear-05-map-then-sink.swift"] },
    { "id": "appear-06-receive-value-reference", "rule": "MW-APPEAR-01", "expect": "fail", "checker": "scan-swift", "sources": ["swift/appear-06-receive-value-reference.swift"] },
    { "id": "appear-07-rooted-key-path", "rule": "MW-APPEAR-01", "expect": "fail", "checker": "scan-swift", "sources": ["swift/appear-07-rooted-key-path.swift"] },
    { "id": "appear-08-remove-duplicates", "rule": "MW-APPEAR-01", "expect": "pass", "checker": "scan-swift", "sources": ["swift/appear-08-remove-duplicates.swift"] },
    { "id": "appear-09-project-type-guard", "rule": "MW-APPEAR-01", "expect": "pass", "checker": "scan-swift", "sources": ["swift/appear-09-project-type-guard.swift"] },
    { "id": "appear-10-tint-layer-display", "rule": "MW-APPEAR-01", "expect": "fail", "checker": "scan-swift", "sources": ["swift/appear-10-tint-layer-display.swift"] },
    { "id": "config-04-one-of-two-statics", "rule": "MW-CONFIG-01", "expect": "fail", "checker": "scan-swift", "args": ["--configurable", "com.example.forecast.daily"], "sources": ["swift/config-04-two-statics.swift"] },
    { "id": "config-05-other-kind-requested", "rule": "MW-CONFIG-01", "expect": "pass", "checker": "scan-swift", "args": ["--configurable", "com.example.forecast.city"], "sources": ["swift/config-06-qualified-intent.swift"] },
    { "id": "config-06-qualified-intent", "rule": "MW-CONFIG-01", "expect": "pass", "checker": "scan-swift", "sources": ["swift/config-06-qualified-intent.swift"] },
    { "id": "warn-01-literal-kind-no-parameter", "rule": ["MW-WARN-KIND", "MW-WARN-PARAMS"], "expect": "warn", "checker": "scan-swift", "sources": ["swift/warn-01-literal-kind-no-parameter.swift"] },
    { "id": "probe-fresh", "rule": "MW-STALE-01", "expect": "pass", "checker": "probe-extension", "app": "probe/Forecast.app", "installed": "2026-11-13T09:00:00", "tz": "+00:00", "ps": "probe/ps-fresh.txt", "lsof": "probe/lsof-fresh.txt" },
    { "id": "probe-started-before-install", "rule": "MW-STALE-01", "expect": "fail", "checker": "probe-extension", "app": "probe/Forecast.app", "installed": "2026-11-13T09:00:00", "tz": "+00:00", "ps": "probe/ps-started-before-install.txt", "lsof": "probe/lsof-started-before-install.txt" },
    { "id": "probe-removed-copy", "rule": "MW-STALE-01", "expect": "fail", "checker": "probe-extension", "app": "probe/Forecast.app", "installed": "2026-11-13T09:00:00", "tz": "+00:00", "ps": "probe/ps-removed-copy.txt", "lsof": "probe/lsof-removed-copy.txt" },
    { "id": "probe-other-apps", "rule": "MW-STALE-01", "expect": "pass", "checker": "probe-extension", "app": "probe/Forecast.app", "copies": ["probe/debug/Forecast.app"], "installed": "2026-11-13T09:00:00", "tz": "+00:00", "ps": "probe/ps-other-apps.txt", "lsof": "probe/lsof-other-apps.txt" },
    { "id": "probe-removed-copy-no-lsof", "rule": "MW-STALE-01", "expect": "fail", "checker": "probe-extension", "app": "probe/Forecast.app", "installed": "2026-11-13T09:00:00", "tz": "+00:00", "ps": "probe/ps-removed-copy.txt", "lsof": "probe/lsof-empty.txt" },
    { "id": "probe-installed-with-offset", "rule": "MW-STALE-01", "expect": "pass", "checker": "probe-extension", "app": "probe/Forecast.app", "installed": "2026-11-13T09:00:00Z", "tz": "+00:00", "ps": "probe/ps-fresh.txt", "lsof": "probe/lsof-fresh.txt" },
    { "id": "snapshot-baseline-same", "rule": ["MW-SNAP-01", "MW-SNAP-02"], "expect": "pass", "checker": "snapshot-widgets", "platform": "darwin", "baselineSources": ["snapshot/StepsCard.swift", "snapshot/Catalog.swift"], "sources": ["snapshot/StepsCard.swift", "snapshot/Catalog.swift"] },
    { "id": "snapshot-baseline-changed", "rule": "MW-SNAP-02", "expect": "fail", "checker": "snapshot-widgets", "platform": "darwin", "baselineSources": ["snapshot/StepsCard.swift", "snapshot/Catalog.swift"], "sources": ["snapshot/StepsCardEdited.swift", "snapshot/Catalog.swift"] },
    { "id": "snapshot-shipped-widget", "rule": "MW-SNAP-01", "expect": "pass", "checker": "snapshot-widgets", "platform": "darwin", "sources": ["assets/ConfigurableWidget.swift", "snapshot/CityCatalog.swift"] },
    { "id": "snapshot-overflow", "rule": "MW-SNAP-01", "expect": "fail", "checker": "snapshot-widgets", "platform": "darwin", "sources": ["snapshot/OverflowCatalog.swift"] },
    { "id": "snapshot-too-wide", "rule": "MW-SNAP-01", "expect": "fail", "checker": "snapshot-widgets", "platform": "darwin", "sources": ["snapshot/WideCatalog.swift"] },
    { "id": "snapshot-content-margins", "rule": "MW-SNAP-01", "expect": "fail", "checker": "snapshot-widgets", "platform": "darwin", "sources": ["snapshot/MarginCatalog.swift"] },
    { "id": "snapshot-empty-catalog", "rule": "MW-SNAP-01", "expect": "fail", "checker": "snapshot-widgets", "platform": "darwin", "sources": ["snapshot/EmptyCatalog.swift"] },
    { "id": "snapshot-duplicate-names", "rule": "MW-SNAP-01", "expect": "fail", "checker": "snapshot-widgets", "platform": "darwin", "sources": ["snapshot/StepsCard.swift", "snapshot/DuplicateCatalog.swift"] },
    { "id": "snapshot-crash-blames-entry", "rule": "MW-SNAP-01", "expect": "fail", "checker": "snapshot-widgets", "platform": "darwin", "expected": "snapshot/crash.expected.json", "sources": ["snapshot/CrashCatalog.swift"] },
    { "id": "snapshot-placeholder-controls", "rule": "MW-SNAP-01", "expect": "warn", "checker": "snapshot-widgets", "platform": "darwin", "sources": ["snapshot/PlaceholderCatalog.swift"] },
    { "id": "snapshot-orphan-baseline", "rule": "MW-SNAP-02", "expect": "warn", "checker": "snapshot-widgets", "platform": "darwin", "baselineSources": ["snapshot/StepsCard.swift", "snapshot/Catalog.swift"], "sources": ["snapshot/StepsCard.swift", "snapshot/CatalogShort.swift"] }
  ]
}
