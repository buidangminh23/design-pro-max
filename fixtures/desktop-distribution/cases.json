{
  "description": "desktop-distribution fixtures. scripts/verify.mjs runs each case against a copy of the shipped part outside the repository. File paths are relative to this folder, or to the part folder when they start with assets/. probe-app cases judge recorded codesign and spctl output (record) and scan the app folder named by app, so they run anywhere; check-installer, check-cask and check-feed cases read one file as text. A fail case must exit 1 with an error for its rule; a pass case must report its rule as passed with no error for it; a warn case must warn for its rule.",
  "cases": [
    { "id": "probe-notarized", "rule": ["DD-SIGN-01", "DD-TEAM-01", "DD-GATE-01"], "expect": "pass", "checker": "probe-app", "app": "probe/apps/Relay.app", "record": "probe/probe-notarized.json" },
    { "id": "probe-broken-seal", "rule": "DD-SIGN-01", "expect": "fail", "checker": "probe-app", "app": "probe/apps/Relay.app", "record": "probe/probe-broken-seal.json" },
    { "id": "probe-unsigned-helper", "rule": "DD-SIGN-01", "expect": "fail", "checker": "probe-app", "app": "probe/apps/Relay.app", "record": "probe/probe-unsigned-helper.json" },
    { "id": "probe-team-mismatch", "rule": "DD-TEAM-01", "expect": "fail", "checker": "probe-app", "app": "probe/apps/Relay.app", "record": "probe/probe-team-mismatch.json" },
    { "id": "probe-outside-runtime", "rule": "DD-TEAM-01", "expect": "fail", "checker": "probe-app", "app": "probe/apps/RelayPath.app", "record": "probe/probe-notarized.json" },
    { "id": "probe-unnotarized", "rule": "DD-GATE-01", "expect": "fail", "checker": "probe-app", "app": "probe/apps/Relay.app", "record": "probe/probe-unnotarized.json" },
    { "id": "probe-adhoc", "rule": "DD-WARN-ADHOC", "expect": "warn", "checker": "probe-app", "app": "probe/apps/Relay.app", "record": "probe/probe-adhoc.json" },
    { "id": "probe-no-runtime", "rule": "DD-WARN-RUNTIME", "expect": "warn", "checker": "probe-app", "app": "probe/apps/Relay.app", "record": "probe/probe-no-runtime.json" },
    { "id": "probe-path-xattr", "rule": "DD-WARN-PATH", "expect": "warn", "checker": "probe-app", "app": "probe/apps/Relay.app", "record": "probe/probe-path-xattr.json" },
    { "id": "installer-shipped", "rule": ["DD-INSTALL-01", "DD-INSTALL-02", "DD-INSTALL-03"], "expect": "pass", "checker": "check-installer", "file": "assets/install-macos.sh" },
    { "id": "installer-minimal", "rule": ["DD-INSTALL-01", "DD-INSTALL-02", "DD-INSTALL-03"], "expect": "pass", "checker": "check-installer", "file": "installers/install-pass-minimal.sh" },
    { "id": "install-01-no-checksum", "rule": "DD-INSTALL-01", "expect": "fail", "checker": "check-installer", "file": "installers/install-01-no-checksum.sh" },
    { "id": "install-01-http", "rule": "DD-INSTALL-01", "expect": "fail", "checker": "check-installer", "file": "installers/install-01-http.sh" },
    { "id": "install-01-insecure", "rule": "DD-INSTALL-01", "expect": "fail", "checker": "check-installer", "file": "installers/install-01-insecure.sh" },
    { "id": "install-01-sum-not-compared", "rule": "DD-INSTALL-01", "expect": "fail", "checker": "check-installer", "file": "installers/install-01-sum-not-compared.sh" },
    { "id": "install-02-no-verify", "rule": "DD-INSTALL-02", "expect": "fail", "checker": "check-installer", "file": "installers/install-02-no-verify.sh" },
    { "id": "install-02-not-strict", "rule": "DD-INSTALL-02", "expect": "fail", "checker": "check-installer", "file": "installers/install-02-not-strict.sh" },
    { "id": "install-02-after-swap", "rule": "DD-INSTALL-02", "expect": "fail", "checker": "check-installer", "file": "installers/install-02-after-swap.sh" },
    { "id": "install-03-rm-then-copy", "rule": "DD-INSTALL-03", "expect": "fail", "checker": "check-installer", "file": "installers/install-03-rm-then-copy.sh" },
    { "id": "install-03-copy-over", "rule": "DD-INSTALL-03", "expect": "fail", "checker": "check-installer", "file": "installers/install-03-copy-over.sh" },
    { "id": "install-warn-xattr-register", "rule": ["DD-WARN-XATTR", "DD-WARN-REGISTER"], "expect": "warn", "checker": "check-installer", "file": "installers/install-warn-xattr-register.sh" },
    { "id": "cask-shipped", "rule": ["DD-CASK-01", "DD-CASK-02", "DD-CASK-03"], "expect": "pass", "checker": "check-cask", "file": "assets/example.rb", "args": ["--self-updating"] },
    { "id": "cask-comment-mentions-postflight", "rule": ["DD-CASK-01", "DD-CASK-02", "DD-CASK-03"], "expect": "pass", "checker": "check-cask", "file": "casks/cask-pass-comment-mentions-postflight.rb", "args": ["--self-updating"] },
    { "id": "cask-01-postflight-block", "rule": "DD-CASK-01", "expect": "fail", "checker": "check-cask", "file": "casks/cask-01-postflight-block.rb" },
    { "id": "cask-01-uninstall-postflight-block", "rule": "DD-CASK-01", "expect": "fail", "checker": "check-cask", "file": "casks/cask-01-uninstall-postflight-block.rb" },
    { "id": "cask-02-uninstall-login-item", "rule": "DD-CASK-02", "expect": "fail", "checker": "check-cask", "file": "casks/cask-02-uninstall-login-item.rb" },
    { "id": "cask-02-uninstall-trash-library", "rule": "DD-CASK-02", "expect": "fail", "checker": "check-cask", "file": "casks/cask-02-uninstall-trash-library.rb" },
    { "id": "cask-03-no-auto-updates", "rule": "DD-CASK-03", "expect": "fail", "checker": "check-cask", "file": "casks/cask-03-no-auto-updates.rb", "args": ["--self-updating"] },
    { "id": "cask-warn-no-check", "rule": "DD-WARN-CASKSHA", "expect": "warn", "checker": "check-cask", "file": "casks/cask-warn-no-check.rb" },
    { "id": "feed-shipped", "rule": "DD-FEED-01", "expect": "pass", "checker": "check-feed", "file": "assets/latest.json" },
    { "id": "feed-every-platform", "rule": "DD-FEED-01", "expect": "pass", "checker": "check-feed", "file": "feeds/feed-pass-every-platform.json", "args": ["--platforms", "darwin-aarch64,darwin-x86_64,windows-x86_64,linux-x86_64"] },
    { "id": "appcast-signed", "rule": "DD-FEED-01", "expect": "pass", "checker": "check-feed", "file": "feeds/appcast-pass.xml" },
    { "id": "feed-01-no-darwin-aarch64", "rule": "DD-FEED-01", "expect": "fail", "checker": "check-feed", "file": "feeds/feed-01-no-darwin-aarch64.json" },
    { "id": "feed-01-no-signature", "rule": "DD-FEED-01", "expect": "fail", "checker": "check-feed", "file": "feeds/feed-01-no-signature.json" },
    { "id": "feed-01-http-url", "rule": "DD-FEED-01", "expect": "fail", "checker": "check-feed", "file": "feeds/feed-01-http-url.json" },
    { "id": "appcast-01-no-signature", "rule": "DD-FEED-01", "expect": "fail", "checker": "check-feed", "file": "feeds/appcast-01-no-signature.xml" }
  ]
}
